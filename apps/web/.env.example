# Copy to apps/web/.env.local and fill in. Never commit the filled file.

# Supabase (shared with the Kotlin app). Staging values for local work.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-never-expose

# Signs step-up tickets and other server-side HMACs. 32+ random bytes.
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Public site origin, used for redirects and CSRF checks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps JS (browser key, restrict by HTTP referrer in Google Cloud).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Sentry. Leave the DSN empty to disable reporting.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=development
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
