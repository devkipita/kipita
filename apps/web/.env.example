# Supabase — the SAME project as the mobile app.
# Copy the values from apps/mobile/.env, mapping the prefixes:
#   EXPO_PUBLIC_SUPABASE_URL  →  NEXT_PUBLIC_SUPABASE_URL
#   EXPO_PUBLIC_SUPABASE_KEY  →  NEXT_PUBLIC_SUPABASE_ANON_KEY
# Then save as apps/web/.env.local and restart `yarn web`.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
