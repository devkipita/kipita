{
  "expo": {
    "name": "Kipita",
    "slug": "kipita",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/favicon_io/android-chrome-512x512.png",
    "scheme": "kipita",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#1B5E20"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kipita.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/favicon_io/android-chrome-512x512.png",
        "backgroundColor": "#1B5E20"
      },
      "package": "com.kipita.app"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kipita needs access to your photos to attach images to road alerts and messages."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Kipita needs microphone access to record voice notes in chat."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2F6C4F"
        }
      ],
      "expo-asset",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
